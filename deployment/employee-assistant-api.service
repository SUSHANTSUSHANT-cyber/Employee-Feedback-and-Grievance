[Unit]
Description=Employee Assistant FastAPI service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=employeeassistant
WorkingDirectory=/opt/EmployeeAssistantServer/api
EnvironmentFile=/opt/EmployeeAssistantServer/.env
ExecStart=/opt/EmployeeAssistantServer/.venv/bin/gunicorn app.main:app -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 --workers 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
